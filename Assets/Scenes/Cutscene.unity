      m_Calls: []
  m_text: ' it is starting to weaken even me. If we do not stop them, I am not sure
    i''ll survive it. But you... You''re different. I felt it. You have yet to receive
    a blessing, something I will have to chastise myself about after this ordeal.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8eac1f03c70c1dc49be8efcfb8e0f5e5, type: 2}
